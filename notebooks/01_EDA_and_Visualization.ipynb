 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Traffic Congestion Prediction - Exploratory Data Analysis\n",
    "\n",
    "This notebook performs comprehensive EDA on the traffic congestion dataset.\n",
    "\n",
    "## Objectives:\n",
    "- Understand data distribution and patterns\n",
    "- Analyze congestion patterns by time, weather, and location\n",
    "- Identify correlations between features\n",
    "- Visualize insights for better understanding"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries\n",
    "import sys\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Add project root to path\n",
    "sys.path.insert(0, os.path.abspath('..'))\n",
    "\n",
    "from config import DATA_DIR, OUTPUT_DIR, CONGESTION_LEVELS, WEATHER_CONDITIONS\n",
    "from src.data_generator import TrafficDataGenerator\n",
    "\n",
    "# Set style\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "sns.set_palette('husl')\n",
    "%matplotlib inline\n",
    "\n",
    "print('Libraries imported successfully!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate or load data\n",
    "data_path = os.path.join(DATA_DIR, 'synthetic_traffic_data.csv')\n",
    "\n",
    "if os.path.exists(data_path):\n",
    "    df = pd.read_csv(data_path)\n",
    "    print(f'Loaded data from {data_path}')\n",
    "else:\n",
    "    print('Generating synthetic data...')\n",
    "    generator = TrafficDataGenerator()\n",
    "    df = generator.generate_dataset(10000)\n",
    "    generator.save_dataset(df)\n",
    "\n",
    "print(f'Dataset shape: {df.shape}')\n",
    "print(f'Columns: {list(df.columns)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic data exploration\n",
    "print('First 5 rows:')\n",
    "display(df.head())\n",
    "\n",
    "print('\\nData info:')\n",
    "df.info()\n",
    "\n",
    "print('\\nDescriptive statistics:')\n",
    "display(df.describe())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Missing values\n",
    "missing = df.isnull().sum()\n",
    "print('Missing values per column:')\n",
    "print(missing[missing > 0] if any(missing > 0) else 'No missing values found')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Congestion Level Distribution\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Bar plot\n",
    "congestion_counts = df['congestion_level'].value_counts().sort_index()\n",
    "colors = ['#2ECC71', '#F1C40F', '#E67E22', '#E74C3C']\n",
    "labels = ['Low', 'Moderate', 'High', 'Severe']\n",
    "\n",
    "axes[0].bar(labels, congestion_counts.values, color=colors, edgecolor='white', linewidth=1.5)\n",
    "axes[0].set_title('Congestion Level Distribution', fontsize=14, fontweight='bold')\n",
    "axes[0].set_xlabel('Congestion Level')\n",
    "axes[0].set_ylabel('Count')\n",
    "for i, v in enumerate(congestion_counts.values):\n",
    "    axes[0].text(i, v + 50, str(v), ha='center', fontweight='bold')\n",
    "\n",
    "# Pie chart\n",
    "axes[1].pie(congestion_counts.values, labels=labels, colors=colors, autopct='%1.1f%%',\n",
    "           startangle=90, explode=[0.05]*4)\n",
    "axes[1].set_title('Congestion Level Proportions', fontsize=14, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Congestion by Hour of Day\n",
    "hourly_avg = df.groupby('hour')['congestion_level'].agg(['mean', 'std', 'count']).reset_index()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 6))\n",
    "\n",
    "ax.plot(hourly_avg['hour'], hourly_avg['mean'], 'o-', color='#3498DB', linewidth=2, markersize=8)\n",
    "ax.fill_between(hourly_avg['hour'], \n",
    "                hourly_avg['mean'] - hourly_avg['std'],\n",
    "                hourly_avg['mean'] + hourly_avg['std'],\n",
    "                alpha=0.2, color='#3498DB')\n",
    "\n",
    "# Highlight rush hours\n",
    "ax.axvspan(7, 9, alpha=0.2, color='red', label='Morning Rush (7-9 AM)')\n",
    "ax.axvspan(17, 19, alpha=0.2, color='orange', label='Evening Rush (5-7 PM)')\n",
    "\n",
    "ax.set_title('Average Congestion Level by Hour of Day', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Hour of Day')\n",
    "ax.set_ylabel('Average Congestion Level')\n",
    "ax.set_xticks(range(0, 24))\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('\\nPeak congestion hours:')\n",
    "print(hourly_avg.nlargest(5, 'mean')[['hour', 'mean']])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Congestion by Day of Week\n",
    "day_names = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n",
    "daily_avg = df.groupby('day_of_week')['congestion_level'].mean()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "\n",
    "bars = ax.bar(day_names, daily_avg.values, color=['#3498DB']*5 + ['#2ECC71']*2, edgecolor='white')\n",
    "ax.set_title('Average Congestion by Day of Week', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Day of Week')\n",
    "ax.set_ylabel('Average Congestion Level')\n",
    "ax.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "for bar, val in zip(bars, daily_avg.values):\n",
    "    ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.02,\n",
    "            f'{val:.2f}', ha='center', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation Heatmap\n",
    "numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
    "corr_matrix = df[numeric_cols].corr()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(16, 12))\n",
    "mask = np.triu(np.ones_like(corr_matrix, dtype=bool))\n",
    "sns.heatmap(corr_matrix, mask=mask, annot=True, fmt='.2f', cmap='RdBu_r',\n",
    "            center=0, square=True, linewidths=0.5, ax=ax)\n",
    "ax.set_title('Feature Correlation Matrix', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('\\nTop features correlated with congestion_level:')\n",
    "cong_corr = corr_matrix['congestion_level'].sort_values(ascending=False)\n",
    "print(cong_corr) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Weather Impact Analysis\n",
    "weather_names = {0: 'Clear', 1: 'Cloudy', 2: 'Rainy', 3: 'Stormy', 4: 'Foggy', 5: 'Snowy'}\n",
    "weather_impact = df.groupby('weather_condition')['congestion_level'].agg(['mean', 'std', 'count'])\n",
    "weather_impact.index = [weather_names[i] for i in weather_impact.index]\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Weather vs Congestion\n",
    "colors_w = ['#3498DB', '#95A5A6', '#5DADE2', '#8E44AD', '#AAB7B8', '#ECF0F1']\n",
    "axes[0].bar(weather_impact.index, weather_impact['mean'], color=colors_w, edgecolor='white')\n",
    "axes[0].set_title('Weather Impact on Congestion', fontsize=14, fontweight='bold')\n",
    "axes[0].set_xlabel('Weather Condition')\n",
    "axes[0].set_ylabel('Average Congestion Level')\n",
    "axes[0].tick_params(axis='x', rotation=45)\n",
    "\n",
    "# Traffic volume by weather\n",
    "weather_volume = df.groupby('weather_condition')['traffic_volume'].mean()\n",
    "weather_volume.index = [weather_names[i] for i in weather_volume.index]\n",
    "axes[1].bar(weather_volume.index, weather_volume.values, color=colors_w, edgecolor='white')\n",
    "axes[1].set_title('Traffic Volume by Weather', fontsize=14, fontweight='bold')\n",
    "axes[1].set_xlabel('Weather Condition')\n",
    "axes[1].set_ylabel('Average Traffic Volume')\n",
    "axes[1].tick_params(axis='x', rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('\\nWeather Impact Details:')\n",
    "display(weather_impact)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Location-wise Analysis\n",
    "location_stats = df.groupby('location')['congestion_level'].agg(['mean', 'std', 'max', 'count']).sort_values('mean', ascending=False)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 6))\n",
    "colors_loc = plt.cm.viridis(np.linspace(0.2, 0.8, len(location_stats)))\n",
    "bars = ax.barh(location_stats.index, location_stats['mean'], color=colors_loc, edgecolor='white')\n",
    "ax.set_title('Average Congestion by Location', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Average Congestion Level')\n",
    "ax.set_ylabel('Location')\n",
    "ax.grid(True, alpha=0.3, axis='x')\n",
    "\n",
    "for bar, val in zip(bars, location_stats['mean']):\n",
    "    ax.text(bar.get_width() + 0.01, bar.get_y() + bar.get_height()/2,\n",
    "            f'{val:.2f}', ha='left', va='center', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('\\nLocation Congestion Rankings:')\n",
    "display(location_stats)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Traffic Volume vs Speed vs Congestion\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "# Volume vs Congestion\n",
    "for level in range(4):\n",
    "    subset = df[df['congestion_level'] == level]\n",
    "    axes[0].hist(subset['traffic_volume'], bins=30, alpha=0.5, label=f'Level {level}', density=True)\n",
    "axes[0].set_title('Traffic Volume Distribution by Congestion', fontsize=12, fontweight='bold')\n",
    "axes[0].set_xlabel('Traffic Volume')\n",
    "axes[0].set_ylabel('Density')\n",
    "axes[0].legend()\n",
    "\n",
    "# Speed vs Congestion\n",
    "for level in range(4):\n",
    "    subset = df[df['congestion_level'] == level]\n",
    "    axes[1].hist(subset['avg_speed'], bins=30, alpha=0.5, label=f'Level {level}', density=True)\n",
    "axes[1].set_title('Average Speed Distribution by Congestion', fontsize=12, fontweight='bold')\n",
    "axes[1].set_xlabel('Average Speed (km/h)')\n",
    "axes[1].set_ylabel('Density')\n",
    "axes[1].legend()\n",
    "\n",
    "# Temperature vs Congestion\n",
    "for level in range(4):\n",
    "    subset = df[df['congestion_level'] == level]\n",
    "    axes[2].hist(subset['temperature'], bins=30, alpha=0.5, label=f'Level {level}', density=True)\n",
    "axes[2].set_title('Temperature Distribution by Congestion', fontsize=12, fontweight='bold')\n",
    "axes[2].set_xlabel('Temperature (°C)')\n",
    "axes[2].set_ylabel('Density')\n",
    "axes[2].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Summary and Key Findings\n",
    "print('=' * 60)\n",
    "print('EDA SUMMARY AND KEY FINDINGS')\n",
    "print('=' * 60)\n",
    "\n",
    "print(f'''\n",
    "1. DATASET OVERVIEW:\n",
    "   - Total samples: {len(df):,}\n",
    "   - Features: {len(df.columns)}\n",
    "   - Locations: {df['location'].nunique()}\n",
    "   - Date range: {df['timestamp'].min()} to {df['timestamp'].max()}\n",
    "\n",
    "2. CONGESTION DISTRIBUTION:\n",
    "   - Low congestion: {(df['congestion_level']==0).mean():.1%}\n",
    "   - Moderate congestion: {(df['congestion_level']==1).mean():.1%}\n",
    "   - High congestion: {(df['congestion_level']==2).mean():.1%}\n",
    "   - Severe congestion: {(df['congestion_level']==3).mean():.1%}\n",
    "\n",
    "3. KEY PATTERNS:\n",
    "   - Peak congestion hours: 7-9 AM and 5-7 PM (rush hours)\n",
    "   - Weekdays show higher congestion than weekends\n",
    "   - Weather conditions significantly impact congestion\n",
    "   - Traffic volume is the strongest predictor of congestion\n",
    "   - Downtown areas experience highest congestion\n",
    "\n",
    "4. CORRELATIONS:\n",
    "   - Traffic volume strongly correlated with congestion\n",
    "   - Average speed inversely correlated with congestion\n",
    "   - Rush hour and time features show moderate correlation\n",
    "   - Weather conditions have moderate impact\n",
    "\"\"\")"
   ]
  }
 ],
