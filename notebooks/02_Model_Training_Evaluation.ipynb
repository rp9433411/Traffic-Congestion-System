 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Traffic Congestion Prediction - Model Training & Evaluation\n",
    "\n",
    "This notebook trains and evaluates multiple ML models for congestion prediction.\n",
    "\n",
    "## Models:\n",
    "1. Random Forest Regressor\n",
    "2. XGBoost Regressor\n",
    "3. LSTM Neural Network\n",
    "4. Linear Regression (Baseline)\n",
    "5. Ensemble (Weighted Average)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries\n",
    "import sys\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import json\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "sys.path.insert(0, os.path.abspath('..'))\n",
    "from config import MODELS_DIR, OUTPUT_DIR\n",
    "from src.train_model import ModelTrainer\n",
    "from src.visualize import TrafficVisualizer\n",
    "\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "%matplotlib inline\n",
    "\n",
    "print('Libraries imported successfully!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize trainer\n",
    "trainer = ModelTrainer()\n",
    "print('ModelTrainer initialized')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare data\n",
    "(X_train_scaled, X_val_scaled, X_test_scaled,\n",
    " X_train_df, X_val_df, X_test_df,\n",
    " y_train, y_val, y_test) = trainer.prepare_data(n_samples=10000)\n",
    "\n",
    "print(f'\\nData shapes:')\n",
    "print(f'  X_train: {X_train_scaled.shape}')\n",
    "print(f'  X_val: {X_val_scaled.shape}')\n",
    "print(f'  X_test: {X_test_scaled.shape}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model 1: Random Forest"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "rf_model = trainer.train_random_forest(X_train_scaled, y_train, X_val_scaled, y_val)\n",
    "print('\\nRandom Forest trained successfully!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model 2: XGBoost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "xgb_model = trainer.train_xgboost(X_train_scaled, y_train, X_val_scaled, y_val)\n",
    "print('\\nXGBoost trained successfully!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model 3: Linear Regression (Baseline)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "lr_model = trainer.train_linear_regression(X_train_scaled, y_train, X_val_scaled, y_val)\n",
    "print('\\nLinear Regression trained successfully!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model 4: LSTM Neural Network"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "lstm_model = trainer.train_lstm(X_train_scaled, y_train, X_val_scaled, y_val)\n",
    "print('\\nLSTM trained successfully!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate all models\n",
    "metrics = trainer.evaluate_models(X_test_scaled, y_test)\n",
    "print('\\nModel Evaluation Metrics:')\n",
    "for name, metric in metrics.items():\n",
    "    print(f'\\n{name.upper()}:')\n",
    "    for k, v in metric.items():\n",
    "        print(f'  {k}: {v}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create ensemble predictions\n",
    "ensemble_metrics = trainer.create_ensemble_predictions(X_test_scaled, y_test)\n",
    "print('\\nEnsemble Performance:')\n",
    "for k, v in ensemble_metrics.items():\n",
    "    print(f'  {k}: {v}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save models and metrics\n",
    "trainer.save_models()\n",
    "trainer.save_metrics(metrics, ensemble_metrics)\n",
    "print('Models and metrics saved!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Visualizations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate visualizations\n",
    "visualizer = TrafficVisualizer()\n",
    "\n",
    "# Model comparison\n",
    "all_metrics = metrics.copy()\n",
    "all_metrics['ensemble'] = ensemble_metrics\n",
    "visualizer.plot_model_comparison(all_metrics)\n",
    "\n",
    "# Feature importance\n",
    "if hasattr(rf_model, 'feature_importances_'):\n",
    "    visualizer.plot_feature_importance(rf_model, trainer.feature_names, 'Random Forest')\n",
    "\n",
    "print('Visualizations generated!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load back data for visualizations\n",
    "data_path = os.path.join('..', 'data', 'synthetic_traffic_data.csv')\n",
    "if os.path.exists(data_path):\n",
    "    data = pd.read_csv(data_path)\n",
    "    visualizer.plot_congestion_distribution(data)\n",
    "    visualizer.plot_congestion_heatmap(data)\n",
    "    visualizer.plot_weather_impact(data)\n",
    "    visualizer.plot_rush_hour_analysis(data)\n",
    "    print('All visualizations complete!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Summary\n",
    "print('=' * 60)\n",
    "print('MODEL TRAINING SUMMARY')\n",
    "print('=' * 60)\n",
    "\n",
    "# Read saved metrics\n",
    "metrics_path = os.path.join(MODELS_DIR, 'metrics.json')\n",
    "if os.path.exists(metrics_path):\n",
    "    with open(metrics_path, 'r') as f:\n",
    "        saved_metrics = json.load(f)\n",
    "    \n",
    "    print(f'\\nModels trained: {len(saved_metrics)}')\n",
    "    for name, metric in saved_metrics.items():\n",
    "        r2 = metric.get('R2', 'N/A')\n",
    "        mae = metric.get('MAE', 'N/A')\n",
    "        accuracy = metric.get('Accuracy', 'N/A')\n",
    "        print(f'  {name.upper()}:')\n",
    "        print(f'    R² Score: {r2}')\n",
    "        print(f'    MAE: {mae}')\n",
    "        print(f'    Accuracy: {accuracy}')\n",
    "        print()\n",
    "    \n",
    "    # Find best model\n",
    "    best_model = max(saved_metrics.items(), \n",
    "                    key=lambda x: x[1].get('R2', 0) if isinstance(x[1], dict) else 0)\n",
    "    print(f'Best Model: {best_model[0].upper()} (R²: {best_model[1].get(\"R2\", \"N/A\")})')\n",
    "\n",
    "print('\\nTraining complete! Ready for inference.')"
   ]
  }
 ],
